OPENCLAW_SERVER_HOST=127.0.0.1
OPENCLAW_SERVER_PORT=3001
OPENCLAW_LLM_PROVIDER=openai-compatible
OPENCLAW_LLM_BASE_URL=http://127.0.0.1:11434/v1
OPENCLAW_LLM_API_KEY=local-development-key
OPENCLAW_LLM_CHAT_MODEL=local-chat
OPENCLAW_LLM_EMBEDDING_MODEL=
OPENCLAW_NETWORK_MODE=offline
OPENCLAW_NETWORK_ALLOW_LOOPBACK=true
OPENCLAW_NETWORK_ALLOWED_HOSTS=127.0.0.1,localhost
OPENCLAW_WORKSPACE_ROOT=.
OPENCLAW_AGENT_OS_ENABLED=true
OPENCLAW_AGENT_OS_HEARTBEAT_INTERVAL_MS=30000
OPENCLAW_AGENT_OS_JOBS_PER_HEARTBEAT=5
OPENCLAW_AGENT_OS_JOB_RETRY_DELAY_MS=60000
OPENCLAW_WEB_PORT=5173
OPENCLAW_WEB_API_BASE_URL=http://localhost:3001
OPENCLAW_CONFIG_FILE=./openclaw.config.json
